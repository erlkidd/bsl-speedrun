# Скопируй в .env и поправь под сервер.
# Локально оставь :80 (сайт на http://localhost).
# На сервере с доменом — Caddy сам выпустит HTTPS-сертификат:
# SITE_ADDRESS=bsl-speedrun.kz, www.bsl-speedrun.kz
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# Сброс пароля по одному логину без подтверждения (1 — разрешён, 0 — выключен)
ALLOW_OPEN_RESET=1
