Процедура ДобавитьКСальдо(Сальдо, Счет, Сумма)
	Текущее = Сальдо[Счет];
	Сальдо.Вставить(Счет, ?(Текущее = Неопределено, 0, Текущее) + Сумма);
КонецПроцедуры

Функция СальдоПоСчетам(Проводки)
	Сальдо = Новый Соответствие;
	Для Каждого Проводка Из Проводки Цикл
		ДобавитьКСальдо(Сальдо, Проводка.Дт, Проводка.Сумма);
		ДобавитьКСальдо(Сальдо, Проводка.Кт, -Проводка.Сумма);
	КонецЦикла;
	Возврат Сальдо;
КонецФункции
