Функция ТопТоваров(Продажи, Сколько)
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Товар");
	Таблица.Колонки.Добавить("Сумма");
	Для Каждого Продажа Из Продажи Цикл
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Продажа);
	КонецЦикла;
	Таблица.Свернуть("Товар", "Сумма");
	Таблица.Сортировать("Сумма Убыв");

	Результат = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Если Результат.Количество() >= Сколько Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(Строка.Товар);
	КонецЦикла;
	Возврат Результат;
КонецФункции
