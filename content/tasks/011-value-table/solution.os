Функция СвернутьПоТоварам(Строки)
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Товар");
	ТЗ.Колонки.Добавить("Количество");
	Для Каждого Стр Из Строки Цикл
		ЗаполнитьЗначенияСвойств(ТЗ.Добавить(), Стр);
	КонецЦикла;
	ТЗ.Свернуть("Товар", "Количество");
	ТЗ.Сортировать("Товар");
	Результат = Новый Массив;
	Для Каждого Стр Из ТЗ Цикл
		Результат.Добавить(Новый Структура("Товар, Количество", Стр.Товар, Стр.Количество));
	КонецЦикла;
	Возврат Результат;
КонецФункции
