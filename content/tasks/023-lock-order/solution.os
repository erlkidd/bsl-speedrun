Функция ПорядокБлокировки(Ключи)
	Список = Новый СписокЗначений;
	Видели = Новый Соответствие;
	Для Каждого Ключ Из Ключи Цикл
		Если Видели[Ключ] = Неопределено Тогда
			Видели.Вставить(Ключ, Истина);
			Список.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;
	Список.СортироватьПоЗначению();
	Возврат Список.ВыгрузитьЗначения();
КонецФункции
