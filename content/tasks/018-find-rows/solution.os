Функция КоличествоНаСкладе(Строки, Склад)
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Склад");
	ТЗ.Колонки.Добавить("Товар");
	ТЗ.Колонки.Добавить("Количество");
	Для Каждого Стр Из Строки Цикл
		ЗаполнитьЗначенияСвойств(ТЗ.Добавить(), Стр);
	КонецЦикла;
	Итого = 0;
	Для Каждого Стр Из ТЗ.НайтиСтроки(Новый Структура("Склад", Склад)) Цикл
		Итого = Итого + Стр.Количество;
	КонецЦикла;
	Возврат Итого;
КонецФункции
