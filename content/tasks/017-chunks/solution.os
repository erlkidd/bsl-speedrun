Функция РазбитьНаПорции(Массив, РазмерПорции)
	Порции = Новый Массив;
	Текущая = Новый Массив;
	Для Каждого Элемент Из Массив Цикл
		Текущая.Добавить(Элемент);
		Если Текущая.Количество() = РазмерПорции Тогда
			Порции.Добавить(Текущая);
			Текущая = Новый Массив;
		КонецЕсли;
	КонецЦикла;
	Если Текущая.Количество() > 0 Тогда
		Порции.Добавить(Текущая);
	КонецЕсли;
	Возврат Порции;
КонецФункции
