Функция ФамилияИнициалы(ФИО)
	Части = СтрРазделить(СокрЛП(ФИО), " ", Ложь);
	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Результат = Новый Массив;
	Результат.Добавить(Части[0]);
	Для Н = 1 По Части.Количество() - 1 Цикл
		Результат.Добавить(Лев(Части[Н], 1) + ".");
	КонецЦикла;
	Возврат СтрСоединить(Результат, " ");
КонецФункции
