Функция СуммыПоКатегориям(Продажи)
	Итоги = Новый Соответствие;
	Для Каждого Продажа Из Продажи Цикл
		Текущая = Итоги[Продажа.Категория];
		Если Текущая = Неопределено Тогда
			Текущая = 0;
		КонецЕсли;
		Итоги.Вставить(Продажа.Категория, Текущая + Продажа.Сумма);
	КонецЦикла;
	Возврат Итоги;
КонецФункции
