Функция ОбработатьВсе(Делители)
	Успешно = 0;
	Ошибки = Новый Массив;
	Для Каждого Делитель Из Делители Цикл
		Попытка
			Результат = 100 / Делитель;
			Успешно = Успешно + 1;
		Исключение
			Ошибки.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Возврат Новый Структура("Успешно, Ошибок", Успешно, Ошибки.Количество());
КонецФункции
