Функция НайтиВОтсортированном(Числа, Искомое)
	Лево = 0;
	Право = Числа.ВГраница();
	Пока Лево <= Право Цикл
		Середина = Цел((Лево + Право) / 2);
		Если Числа[Середина] = Искомое Тогда
			Возврат Середина;
		ИначеЕсли Числа[Середина] < Искомое Тогда
			Лево = Середина + 1;
		Иначе
			Право = Середина - 1;
		КонецЕсли;
	КонецЦикла;
	Возврат -1;
КонецФункции
