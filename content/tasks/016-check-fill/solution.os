Функция НезаполненныеПоля(Данные, ОбязательныеПоля)
	Результат = Новый Массив;
	Для Каждого ИмяПоля Из СтрРазделить(ОбязательныеПоля, ",", Ложь) Цикл
		ИмяПоля = СокрЛП(ИмяПоля);
		Значение = Неопределено;
		Если Не Данные.Свойство(ИмяПоля, Значение) Или Не ЗначениеЗаполнено(Значение) Тогда
			Результат.Добавить(ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции
