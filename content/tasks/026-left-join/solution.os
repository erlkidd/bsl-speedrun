Функция ЦеныТоваров(Товары, Цены)
	ЦенаПоКоду = Новый Соответствие;
	Для Каждого Строка Из Цены Цикл
		ЦенаПоКоду.Вставить(Строка.Код, Строка.Цена);
	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого Товар Из Товары Цикл
		Цена = ЦенаПоКоду[Товар.Код];
		Если Цена = Неопределено Тогда
			Цена = 0;
		КонецЕсли;
		Результат.Добавить(Товар.Имя + ": " + Формат(Цена, "ЧН=0; ЧГ=0"));
	КонецЦикла;
	Возврат Результат;
КонецФункции
