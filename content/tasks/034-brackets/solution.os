Функция СкобкиСбалансированы(Текст)
	Глубина = 0;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Символ = ")" Тогда
			Глубина = Глубина - 1;
			Если Глубина < 0 Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Глубина = 0;
КонецФункции
