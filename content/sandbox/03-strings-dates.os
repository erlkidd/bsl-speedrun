// Строки и даты
Текст = "  Тренажёр по языку 1С  ";
Сообщить("[" + СокрЛП(Текст) + "]");
Сообщить(ВРег(СокрЛП(Текст)));
Сообщить("Позиция '1С': " + СтрНайти(Текст, "1С"));

Д = Дата(2026, 11, 5, 23, 0, 0);
Сообщить(Формат(Д, "ДФ='dd MMMM yyyy, HH:mm'"));
Сообщить("Начало месяца: " + Формат(НачалоМесяца(Д), "ДЛФ=D"));
Сообщить("Через месяц: " + Формат(ДобавитьМесяц(Д, 1), "ДЛФ=D"));
Сообщить("Дней до Нового года: " + (Дата(2027, 1, 1) - НачалоДня(Д)) / 86400);
