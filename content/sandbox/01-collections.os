// Коллекции: массив, структура, соответствие
Числа = Новый Массив;
Для Н = 1 По 5 Цикл
	Числа.Добавить(Н * Н);
КонецЦикла;
Сообщить("Квадраты: " + СтрСоединить(Числа, ", "));

Сотрудник = Новый Структура("Имя, Возраст", "Артур", 25);
Для Каждого КлючИЗначение Из Сотрудник Цикл
	Сообщить(КлючИЗначение.Ключ + " = " + КлючИЗначение.Значение);
КонецЦикла;

Цены = Новый Соответствие;
Цены.Вставить("Чай", 500);
Цены.Вставить("Кофе", 900);
Сообщить("Кофе стоит " + Цены["Кофе"]);
Сообщить("Сока нет: " + (Цены["Сок"] = Неопределено));
