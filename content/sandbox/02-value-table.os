// ТаблицаЗначений: группировка и сортировка
Продажи = Новый ТаблицаЗначений;
Продажи.Колонки.Добавить("Товар");
Продажи.Колонки.Добавить("Сумма");

Данные = СтрРазделить("Чай:500,Кофе:900,Чай:300,Сок:200", ",");
Для Каждого Пара Из Данные Цикл
	Части = СтрРазделить(Пара, ":");
	Строка = Продажи.Добавить();
	Строка.Товар = Части[0];
	Строка.Сумма = Число(Части[1]);
КонецЦикла;

Продажи.Свернуть("Товар", "Сумма");
Продажи.Сортировать("Сумма Убыв");
Для Каждого Строка Из Продажи Цикл
	Сообщить(СтрШаблон("%1: %2", Строка.Товар, Строка.Сумма));
КонецЦикла;
Сообщить("Итого: " + Продажи.Итог("Сумма"));
