// Исключения: Попытка ... Исключение
Функция Разделить(А, Б)
	Если Б = 0 Тогда
		ВызватьИсключение "Деление на ноль запрещено";
	КонецЕсли;
	Возврат А / Б;
КонецФункции

Попытка
	Сообщить(Разделить(10, 2));
	Сообщить(Разделить(1, 0));
Исключение
	Сообщить("Поймали: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
КонецПопытки;
