
// ==== служебный код проверки (добавляется после кода ученика) ====

Функция _ВСтроку(Знач З)
	Т = ТипЗнч(З);
	Если Т = Тип("Массив") Или Т = Тип("ФиксированныйМассив") Тогда
		Ч = Новый Массив;
		Для Каждого Э Из З Цикл
			Ч.Добавить(_ВСтроку(Э));
		КонецЦикла;
		Возврат "[" + СтрСоединить(Ч, ", ") + "]";
	ИначеЕсли Т = Тип("Структура") Или Т = Тип("Соответствие") Или Т = Тип("ФиксированнаяСтруктура") Тогда
		Ч = Новый Массив;
		Для Каждого КЗ Из З Цикл
			Ч.Добавить(_ВСтроку(КЗ.Ключ) + ": " + _ВСтроку(КЗ.Значение));
		КонецЦикла;
		_Сортировать(Ч);
		Возврат "{" + СтрСоединить(Ч, ", ") + "}";
	ИначеЕсли Т = Тип("Строка") Тогда
		Возврат """" + З + """";
	ИначеЕсли Т = Тип("Неопределено") Тогда
		Возврат "Неопределено";
	ИначеЕсли Т = Тип("Булево") Тогда
		Возврат ?(З, "Истина", "Ложь");
	ИначеЕсли Т = Тип("Число") Тогда
		Возврат Формат(З, "ЧРД=.; ЧГ=0; ЧН=0");
	ИначеЕсли Т = Тип("Дата") Тогда
		Возврат Формат(З, "ДФ=yyyy-MM-ddTHH:mm:ss");
	Иначе
		Возврат Строка(З);
	КонецЕсли;
КонецФункции

Процедура _Сортировать(Массив)
	Для И = 0 По Массив.Количество() - 1 Цикл
		Для К = 0 По Массив.Количество() - 2 - И Цикл
			Если Массив[К] > Массив[К + 1] Тогда
				Б = Массив[К];
				Массив[К] = Массив[К + 1];
				Массив[К + 1] = Б;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Функция _Экр(Знач С)
	Возврат СтрЗаменить(СтрЗаменить(СтрЗаменить(Строка(С), Символы.Таб, " "), Символы.ВК, ""), Символы.ПС, "⏎");
КонецФункции

Процедура _Вывод(Статус, Имя, Ожидание, Факт)
	Сообщить("##CASE##" + Символы.Таб + Статус + Символы.Таб + _Экр(Имя) + Символы.Таб + _Экр(Ожидание) + Символы.Таб + _Экр(Факт));
КонецПроцедуры

Процедура _Проверить(Имя, Факт, Ожидание)
	Ф = _ВСтроку(Факт);
	О = _ВСтроку(Ожидание);
	_Вывод(?(Ф = О, "PASS", "FAIL"), Имя, О, Ф);
КонецПроцедуры

Процедура _Ошибка(Имя, Ожидание, Текст)
	_Вывод("ERROR", Имя, _ВСтроку(Ожидание), Текст);
КонецПроцедуры

// ==== тело проверки ====
